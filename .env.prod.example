# Copy this file to .env.prod and fill in real values for a production deployment.
# .env.prod is gitignored (see .gitignore's ".env.*" pattern) and must never be
# committed. Used by:
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# This is a SEPARATE file from .env.example (the local-dev profile, unchanged) -- see
# README "Secrets & Configuration" for why build-time, runtime, secret, and
# non-secret configuration are kept in clearly separate places rather than one file
# that tries to cover both profiles.

# --- Backend authentication (required) ---
# Generate real, unique values -- do NOT reuse .env.example's placeholders. The
# backend logs a loud warning at startup (never the value itself) if it detects the
# literal .env.example placeholder string still in use (Phase 12).
CYBER_AI_API_KEY=
CYBER_AI_USERNAME=
CYBER_AI_PASSWORD=

# --- Ollama ---
# Where does the LLM run? See README "Where does the LLM run?" for the full
# discussion. If Ollama runs on the same host as this Compose stack (outside it, same
# as docker-compose.yml's local profile), host.docker.internal still works. If Ollama
# runs on a separate GPU host, point this at its real address -- e.g.
# http://10.0.1.20:11434 -- and make sure that host's Ollama is NOT exposed to the
# public internet (see README "Security Deployment Audit").
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- CORS (backend) ---
# Your real, public HTTPS frontend origin(s), comma-separated. Must NOT contain '*'
# (backend/config_validation.py rejects that combined with credentialed cookies).
CORS_ORIGINS=https://app.example.com

# --- Frontend ---
# Your real, public HTTPS backend origin -- what the BROWSER uses, not an internal
# Docker address.
VITE_API_URL=https://api.example.com

# --- Reverse-proxy trust (Phase 12) ---
# The address(es) uvicorn should trust to supply X-Forwarded-For/X-Forwarded-Proto
# (see README "Networking" for the exact mechanism and how it was verified locally).
# Leaving this unset is SAFE (uvicorn's own default, 127.0.0.1, matches "no proxy
# configured yet" and preserves today's direct-connection behavior) but means rate
# limiting and access logs will see the reverse proxy's address, not real client IPs,
# until this is set correctly for your environment. Do NOT set this to "*" or to a
# broad/public range -- that would let any client spoof its own IP for rate-limiting
# purposes. Determine the correct value by inspecting your actual proxy's network
# address (e.g. `docker network inspect <network>` for its gateway IP, or your cloud
# load balancer's documented internal address range).
FORWARDED_ALLOW_IPS=127.0.0.1
