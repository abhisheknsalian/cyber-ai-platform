# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Vector databases
rag/chroma_db/
rag/multi_threat_db/

# Threat graph (Phase 9) -- deterministically rebuilt from data/threat_intel/*.txt
# via `uv run python -m backend.intelligence.ingestion`, same pattern as chroma_db/
# above. Not required at runtime either -- get_graph() builds it in memory on demand.
rag/graph/

# Trained ML model artifacts
models/

# Phase 11 evaluation reports -- generated by `uv run python -m backend.evaluation`,
# reproducible on demand from the dataset/model/vector store/graph, same pattern as
# rag/chroma_db/ and rag/graph/ above. Anchored to the repo root (leading slash) so
# this does NOT also match backend/evaluation/, which is real source code.
/evaluation/

# OS files
.DS_Store
Thumbs.db

# Large model/cache files
*.bin
*.pt
*.pth

# VS Code settings (optional)
.vscode/

data/raw/

# Local-dev SQLite database (Phase 13's users table) -- default DATABASE_URL target
# for non-Docker local dev; contains real (hashed) user accounts, never committed.
# See backend/db/session.py and README "Database Architecture".
data/cyber_ai.db
data/cyber_ai.db-*

# docker-compose.yml reads a root .env by convention (never committed; see
# .env.example for the placeholder template). docker-compose.prod.yml reads .env.prod
# the same way (Phase 12) -- see .env.prod.example for its placeholder template.
.env
.env.*
!.env.example
!.env.prod.example