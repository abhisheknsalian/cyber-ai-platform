# Copy this file to .env and fill in real values. .env is gitignored and must never
# be committed. Used by `docker compose up` (docker-compose.yml) to configure the
# backend and frontend containers.

# --- Backend authentication (required) ---
# API-key clients: Authorization: Bearer <this value>
CYBER_AI_API_KEY=changeme-generate-a-long-random-value
# Browser session login (POST /auth/login) -- a demo/bootstrap account, separate from
# real registered users (POST /auth/register). See README "Authentication".
CYBER_AI_USERNAME=changeme
CYBER_AI_PASSWORD=changeme-use-a-strong-password

# --- Database (required) ---
# Dedicated PostgreSQL service ("db" in docker-compose.yml) for persistent user
# accounts (Phase 13). POSTGRES_USER/DB have safe defaults below; only the password
# is required. DATABASE_URL itself is derived automatically from these three in
# docker-compose.yml -- set it directly only to point at a different database.
POSTGRES_USER=cyber_ai
POSTGRES_PASSWORD=changeme-generate-a-long-random-value
POSTGRES_DB=cyber_ai

# --- Ollama (running on the host, not in this Compose stack) ---
# host.docker.internal lets the backend container reach a host-installed Ollama.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- CORS (backend) ---
# Comma-separated list of origins allowed to call the API with credentials.
# Defaults already cover the Vite dev server (5173) and the published nginx
# frontend port (8080) below -- only change this if you change either port.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Frontend ---
# Must be reachable from the browser (the host machine), not from inside the
# frontend container -- so this is the backend's host-published port, never the
# Compose service name "backend".
VITE_API_URL=http://localhost:8000
